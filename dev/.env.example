# Copy to dev/.env and fill in. Used by docker compose (api) and by the frontend.

# --- API (Deno) ---
PORT=8000
NODE_ENV=development

# Supabase — service role key, server side only, never expose to the browser
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=anotherbrainfileplayground

# OpenAI — used for both embeddings and chat
OPENAI_API_KEY=sk-your-openai-api-key

# Set by compose for the container network; these values are the local fallbacks
QDRANT_URL=http://localhost:6333
DOC_PARSER_URL=http://localhost:8080

# Comma separated
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ---
# Anon key only. It is public by design, so the database must have RLS enabled.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:8000/v1

# --- Document parser (Go) ---
GIN_MODE=release
